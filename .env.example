# Copy this file to .env.local and put your real keys there.
# .env.local is ignored by git — never commit real keys.

# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: fallback models (comma-separated, tried in order) when the main model is busy
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Tavily web search API key: https://app.tavily.com
TAVILY_API_KEY=
